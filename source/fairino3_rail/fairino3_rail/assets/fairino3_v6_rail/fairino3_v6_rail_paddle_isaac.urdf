       ================================================================ -->
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.00049027 -0.00045095 0.032527"
        rpy="0 0 0" />
      <mass
        value="0.78393" />
      <inertia
        ixx="0.0013854"
        ixy="1.1455E-05"
        ixz="-1.0642E-05"
        iyy="0.0013849"
        iyz="-9.7435E-06"
        izz="0.001977" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
