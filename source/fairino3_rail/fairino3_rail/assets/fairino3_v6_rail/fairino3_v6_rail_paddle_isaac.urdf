<?xml version="1.0" encoding="utf-8"?>
<robot name="fairino3_v6_rail">
  <!-- ================================================================
       Y-axis prismatic rail — allows the whole arm to slide parallel
       to the net.  rail_base is fixed to the world; rail_y moves
       base_link ±0.35 m in Y.
       ================================================================ -->
  <link name="rail_base">
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <mass value="8.0" />
      <inertia ixx="0.15" ixy="0" ixz="0" iyy="0.80" iyz="0" izz="0.80" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.82 0.14 0.08" />
      </geometry>
      <material name="rail_grey">
        <color rgba="0.35 0.35 0.38 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.82 0.14 0.08" />
      </geometry>
    </collision>
  </link>

  <joint name="rail_y" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="rail_base" />
    <child link="base_link" />
    <axis xyz="1 0 0" />
    <limit lower="-0.35" upper="0.35" effort="150" velocity="0.5" />
    <dynamics damping="40" friction="0.5" />
  </joint>

  <!-- ================================================================
